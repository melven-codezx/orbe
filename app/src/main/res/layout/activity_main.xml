<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orbe_surface">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- barra de progresso superior -->
    <View
        android:id="@+id/progressTrack"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#12102030" />

    <View
        android:id="@+id/progressBar"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@drawable/bg_progress"
        android:visibility="invisible" />

    <!-- fundo escurecido da janela flutuante -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/orbe_scrim"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/uiLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="104dp"
            android:background="@drawable/bg_panel"
            android:elevation="20dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="14dp"
            android:paddingBottom="18dp"
            android:visibility="gone">

            <!-- cabeçalho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.01"
                        android:text="@string/app_name"
                        android:textColor="@color/orbe_ink"
                        android:textSize="21sp" />

                    <TextView
                        android:id="@+id/subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-2dp"
                        android:letterSpacing="0.06"
                        android:text="@string/tagline"
                        android:textAllCaps="true"
                        android:textColor="@color/orbe_ink_soft"
                        android:textSize="10sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnReload"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_iconbtn"
                    android:contentDescription="@string/reload"
                    android:padding="9dp"
                    android:src="@drawable/ic_refresh" />

                <ImageView
                    android:id="@+id/btnClose"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_iconbtn"
                    android:contentDescription="@string/close"
                    android:padding="9dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                android:layout_marginEnd="6dp"
                android:background="#0F0C1024" />

            <!-- modo desktop -->
            <LinearLayout
                android:id="@+id/rowDesktop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.85"
                    android:contentDescription="@string/desktop_mode"
                    android:src="@drawable/ic_monitor" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblDesktop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/desktop_mode"
                        android:textColor="@color/orbe_ink"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/lblDesktopDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/desktop_mode_desc"
                        android:textColor="@color/orbe_ink_soft"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <com.orbe.browser.ui.OrbeSwitch
                    android:id="@+id/switchDesktop"
                    android:layout_width="56dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <!-- estado do telemóvel (RAM/disco em tempo real) -->
            <LinearLayout
                android:id="@+id/rowStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/lblStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/device_status"
                    android:textColor="@color/orbe_ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/lblStatusDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="—"
                    android:textColor="@color/orbe_ink_soft"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <com.orbe.browser.ui.OrbeAction
                android:id="@+id/btnClear"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="6dp" />

            <com.orbe.browser.ui.OrbeAction
                android:id="@+id/btnHome"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="6dp" />

        </LinearLayout>

        <com.orbe.browser.ui.OrbeFab
            android:id="@+id/fab"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="18dp"
            android:contentDescription="@string/open_panel" />

    </FrameLayout>
</FrameLayout>
